# .env.example -> .env.local болгож хуулна.
# Backend (FastAPI)-ийн хаяг. NEXT_PUBLIC_ хувьсагч build хийх үед кодонд суудаг тул
# утгыг өөрчилсний дараа заавал дахин build/deploy хийнэ.
# Production-д https:// байх ёстой (https сайтаас http API руу хандвал хөтөч хориглоно).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
